{
  "name": "baltimorean-map-game-server",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless backend (accounts, guests, server-side scoring, leaderboards) for The Baltimorean Map Game",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "names": "node scripts/check-names.mjs",
    "test": "vitest run",
    "build": "sam build",
    "deploy": "sam deploy --guided"
  },
  "dependencies": {
    "aws-jwt-verify": "^4.0.1",
    "obscenity": "^0.4.6"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.5.4",
    "vitest": "^2.1.0"
  }
}
